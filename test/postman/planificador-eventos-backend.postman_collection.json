		{
			"name": "0. Autenticación (US-11)",
			"item": [
				{
					"name": "POST /api/users/register (crea la cuenta y guarda el token)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/users/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"users",
								"register"
							]
						},
						"description": "Alta de cuenta. Devuelve 201 con { token, tokenType, expiresIn, usuario }. Si el correo ya existe responde 409: en ese caso usar el login de abajo. El script de test guarda el token en la variable de colección {{token}}.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"{{nombre}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"event": "test",
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"if (json.token) {",
									"    pm.collectionVariables.set('token', json.token);",
									"    console.log('Token guardado en {{token}}');",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "POST /api/users/login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
