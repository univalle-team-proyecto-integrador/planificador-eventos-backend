# Conexión a Supabase/PostgreSQL (12-factor: la URL completa entra por entorno)
DB_URL=jdbc:postgresql://db.XXX.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=[TU-CONTRASEÑA]

# US-11 · Autenticación JWT
# OBLIGATORIO en cualquier entorno. Mínimo 32 caracteres para HS256.
# Generar uno: openssl rand -base64 48
# NUNCA versionar el valor real: en Render se fija a mano (sync: false).
JWT_SECRET=[CAMBIA-ESTO-POR-UN-SECRETO-ALEATORIO-DE-32-O-MAS-CARACTERES]

# Caducidad del token en segundos (8 horas por defecto)
JWT_EXPIRATION_SECONDS=28800

# Interruptor de despliegue de US-11.
# false = las rutas /api/subtareas/** siguen abiertas y los datos se acotan al
#         usuario legado LEGACY_USER_ID (para no romper el frontend aún sin login).
# true  = /api/subtareas/** exige Authorization: Bearer <token>.
# Subirlo a true SOLO cuando el frontend ya envíe el token.
PROTECT_SUBTAREAS=false

# Usuario legado usado únicamente mientras PROTECT_SUBTAREAS=false
LEGACY_USER_ID=1
